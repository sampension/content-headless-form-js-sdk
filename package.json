{
  "name": "content-headless-form-js-sdk",
  "version": "1.0.1",
  "description": "Workspace root",
  "workspaces": [
    "src/@episerver/forms-react",
    "src/@episerver/forms-sdk"
  ],
  "author": "Optimizely",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sampension/content-headless-form-js-sdk.git"
  },
  "scripts": {
    "setup-database": "setup.cmd",
    "setup-forms-sdk": "npm install -w @sampension/forms-sdk",
    "setup-forms-react": "npm install -w @sampension/forms-react",
    "setup": "npm run setup-forms-sdk && npm run setup-forms-react && npm run setup-react-app && npm run setup-backend && npm run setup-database",
    "build-forms-sdk": "npm run build -w @sampension/forms-sdk",
    "build-forms-react": "npm run build -w @sampension/forms-react",
    "build": "npm run build-forms-sdk && npm run build-forms-react",
    "test-forms-sdk": "npm run test -w @sampension/forms-sdk",
    "test": "npm run test-forms-sdk",
    "publish-forms-sdk": "npm publish -w @sampension/forms-sdk --tag latest",
    "publish-forms-react": "npm publish -w @sampension/forms-react --tag latest",
    "publish": "npm run publish-forms-sdk && npm run publish-forms-react"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.15"
  }
}
